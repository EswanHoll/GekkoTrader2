{
  "name": "gekkotrader-ui",
  "private": true,
  "version": "0.1.0",
  "description": "GekkoTrader dashboard — React 19 + Vite (in-place modernization of frontend/).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/spa-route-html.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "tsx --test tests/*.test.js",
    "test:legacy": "node --test legacy/tests/*.test.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.84.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  }
}
